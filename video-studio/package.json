{
  "name": "video-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Affiliate product video generator: upload product images, pick a template, render an MP4.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./data/** src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "express": "5.3.0",
    "mediabunny": "1.62.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/kanit": "5.3.0",
    "@remotion/cli": "4.0.539",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
