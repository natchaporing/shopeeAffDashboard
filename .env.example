# --- Shopee Affiliate Open API ---------------------------------------------
# From affiliate.shopee.<region> -> Open API. Never commit the real .env.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Region TLD decides the host: co.th, sg, com.my, co.id, vn, ph, com.br, tw
SHOPEE_REGION=co.th
# Optional full override of the GraphQL endpoint (leave blank to derive from region)
SHOPEE_ENDPOINT=
# Signature scheme. "sha256" = official docs: SHA256(appId + timestamp + body + secret).
# "hmac" = HMAC-SHA256(key=secret, msg=appId + timestamp + body). Keep "sha256" unless a probe fails.
SHOPEE_SIGNATURE_MODE=sha256

# --- Discovery -------------------------------------------------------------
# productOfferV2 listType: 0 all, 1 highest commission, 2 top performing, 3 recommended, 4 trending
SHOPEE_LIST_TYPE=2
# productOfferV2 sortType: 1 latest, 2 highest commission, 3 highest price, 4 lowest price, 5 highest sales
SHOPEE_SORT_TYPE=5
# Items per page (API max is 50) and how many pages to walk per category per day
SHOPEE_PAGE_SIZE=50
SHOPEE_MAX_PAGES=20
# Comma-separated productCatId list to pull. Blank = single un-filtered discovery pull.
SHOPEE_CATEGORY_IDS=
# Set to 1 to use the built-in synthetic data source instead of the live API (dev / demo)
SHOPEE_MOCK=0
# On startup, if the DB is empty, backfill this many days of synthetic data (demo mode). 0 = off.
SEED_MOCK_DAYS=0

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopee_aff

# --- Scheduler -------------------------------------------------------------
# Daily pull time (server local time). Set INGEST_ENABLED=0 to rely on system cron instead.
INGEST_ENABLED=1
INGEST_HOUR=6
INGEST_MINUTE=30

# --- Metric windows / thresholds (tune once real data is visible) ----------
VELOCITY_WINDOW_DAYS=3
ROCKET_TOP_N=10
HIDDEN_MIN_MONTHLY_SALES=500
HIDDEN_MIN_GAP_PERCENTILE=80
PROVEN_MIN_CUMULATIVE_SALES=10000
PROVEN_MIN_RATING=4.8
RISING_MIN_VELOCITY=3
FADING_MAX_VELOCITY=-3
